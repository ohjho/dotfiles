{
  "$description": "Keystone: colour = signal temperature. Hot tokens mark what the model attends to, cold tokens what it ignores; every other colour stays quiet so the ramp reads as meaning, not decoration.",
  "color": {
    "light": {
      "bg": {
        "$type": "color",
        "$value": "#F3F5F4",
        "$extensions": {
          "design-derivation": {
            "from": "constraint"
          }
        },
        "$description": "cool off-white so the hot ramp stays legible"
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF",
