# ===========================================
#  Optional Environment Variables for scripts
# ===========================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# -------------------------------------------
# imgbb upload
# -------------------------------------------
IMGBB_API_KEY=your-imgbb-api-key

# -------------------------------------------
# AWS related scripts
# -------------------------------------------
AWS_PROFILE=your-sso-profile-name

# ===========================================
#  Environment Variable for running
#  Claude Code with OpenRouter: see README
# ===========================================
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=sk-or-v1-your-openrouter-key
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_SONNET_MODEL=anthropic/claude-sonnet-4-6
ANTHROPIC_DEFAULT_OPUS_MODEL=anthropic/claude-opus-4-8
ANTHROPIC_DEFAULT_HAIKU_MODEL=anthropic/claude-haiku-4-5

# ===========================================
#  Environment Variable for running
#  Claude Code with Ollama instead: see README
# ===========================================
# ANTHROPIC_BASE_URL=http://localhost:11434
# ANTHROPIC_AUTH_TOKEN=ollama
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=qwen3-coder
# ANTHROPIC_DEFAULT_SONNET_MODEL=qwen3-coder
# ANTHROPIC_DEFAULT_OPUS_MODEL=qwen3-coder
# ANTHROPIC_DEFAULT_HAIKU_MODEL=qwen3-coder
